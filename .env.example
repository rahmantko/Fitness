# Required in production: long random string used to sign login sessions.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Optional. Postgres connection string (e.g. Supabase). When empty, an embedded
# Postgres is stored in ./data/pglite for local development.
DATABASE_URL=

# Optional. Sends "forgot password" emails via https://resend.com.
# Without a key the reset link is printed in the server log instead.
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. Checkpoint <hello@yourdomain.com>
EMAIL_FROM=
