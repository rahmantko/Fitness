# Required in production: long random string used to sign login sessions.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Optional. Postgres connection string (e.g. Supabase). When empty, an embedded
# Postgres is stored in ./data/pglite for local development.
DATABASE_URL=

# Optional: sends "forgot password" emails. Set ONE of these keys.
# Without one, the reset link is printed in the server log instead.
BREVO_API_KEY=       # https://brevo.com - works with a single verified email address
RESEND_API_KEY=      # https://resend.com - needs a verified domain
# Sender, e.g. Checkpoint <you@gmail.com> (must be verified with your provider)
EMAIL_FROM=

# Admin control centre (/admin): comma-separated emails of people who can manage everything.
# ADMIN_EMAILS=you@example.com
